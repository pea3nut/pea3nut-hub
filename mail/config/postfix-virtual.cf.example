# Copy this file to postfix-virtual.cf in the same directory, then uncomment
# the rules you want and replace every example destination with your own inbox.
# Format: source-address  destination-address

# A single address:
# me@pea3nut.org your-name@gmail.com

# Forward service notices as well:
# postmaster@pea3nut.org your-name@gmail.com

# Optional catch-all: all otherwise unmatched addresses at this domain.
# Keep specific rules above the catch-all.
# @pea3nut.org your-name@gmail.com
