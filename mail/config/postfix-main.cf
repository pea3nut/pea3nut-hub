# This instance only forwards aliases; it has no local mailbox accounts.
# DMS derives /etc/postfix/vhost from source domains in postfix-virtual.cf.
# Use that list as alias domains so unknown recipients are rejected at RCPT TO.
virtual_mailbox_domains =
virtual_mailbox_maps =
virtual_alias_domains = /etc/postfix/vhost

# Only signed SRS addresses may receive delivery-status notifications here.
# SRS_DOMAINNAME in docker-compose.yml must match this domain.
relay_domains = srs.pea3nut.org
relay_recipient_maps = tcp:127.0.0.1:10002

# Never grant unauthenticated relay privileges to the Docker host or subnet.
mynetworks = 127.0.0.0/8
smtpd_sasl_auth_enable = no
smtpd_relay_restrictions = reject_unauth_destination
smtpd_recipient_restrictions = reject_non_fqdn_recipient, reject_unlisted_recipient
smtpd_reject_unlisted_recipient = yes

# Preserve original forwarding headers/body and require encrypted outbound SMTP.
# DMS may reverse SRS recipient addresses in bounce headers, as intended.
sender_canonical_classes = envelope_sender
always_add_missing_headers = no
smtp_header_checks =
header_checks =
smtp_tls_security_level = encrypt
smtp_tls_mandatory_protocols = >=TLSv1.2
inet_protocols = ipv4

# Per-client limits are enforced by Postfix's anvil service (60-second window).
smtpd_client_connection_count_limit = 20
smtpd_client_connection_rate_limit = 60
smtpd_client_message_rate_limit = 100
smtpd_client_event_limit_exceptions =
default_process_limit = 50

# DMS persists the queue and SRS secret under the mounted /var/mail-state.
maximal_queue_lifetime = 5d
bounce_queue_lifetime = 5d
