#!/bin/bash

set -euo pipefail

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
ROOT="$( dirname "$DIR" )"
cd "$ROOT"

if docker compose version >/dev/null 2>&1; then
    COMPOSE=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
    COMPOSE=(docker-compose)
else
    echo 'Docker Compose is required (docker compose or docker-compose).' >&2
    exit 1
fi
COMPOSE+=(-p pea3nut-mail -f "$ROOT/docker-compose.mail.yml")

require_config() {
    if [ ! -f "$ROOT/mail/mail.env" ] || [ ! -f "$ROOT/mail/config/forwards" ]; then
        echo 'First copy mail/mail.env.example to mail/mail.env and mail/forwards.example to mail/config/forwards, then edit your forwarding targets. See mail/README.md.' >&2
        exit 1
    fi
}

reload_mail() {
    "${COMPOSE[@]}" exec -T mail-forwarder python3 /opt/mail-forwarder/runtime.py reload
}

case "${1:-help}" in
    build)
        require_config
        "${COMPOSE[@]}" build --pull mail-forwarder
        ;;
    check)
        require_config
        "${COMPOSE[@]}" run --rm --no-deps mail-forwarder check
        ;;
    up)
        require_config
        mkdir -p "$ROOT/mail/queue" "$ROOT/mail/state"
        "${COMPOSE[@]}" build mail-forwarder
        "${COMPOSE[@]}" run --rm --no-deps mail-forwarder check
        "${COMPOSE[@]}" up -d --no-build mail-forwarder
        ;;
    reload)
        require_config
        reload_mail
        ;;
    renew)
        # Certbot also renews the website certificates. A stopped mail service
        # should stay stopped, rather than making unrelated renewals fail.
        if [ ! -f "$ROOT/mail/mail.env" ]; then
            exit 0
        fi
        container_id="$( "${COMPOSE[@]}" ps -q mail-forwarder )"
        if [ -n "$container_id" ] && [ "$( docker inspect -f '{{.State.Running}}' "$container_id" )" = true ]; then
            reload_mail
        fi
        ;;
    install-renew-hook)
        require_config
        hook_dir=/etc/letsencrypt/renewal-hooks/deploy
        mkdir -p "$hook_dir"
        printf '#!/bin/bash\nset -e\n%q renew\n' "$ROOT/scripts/mail" > "$hook_dir/pea3nut-mail"
        chmod 750 "$hook_dir/pea3nut-mail"
        echo "Installed $hook_dir/pea3nut-mail"
        ;;
    stop)
        require_config
        "${COMPOSE[@]}" stop mail-forwarder
        ;;
    status)
        require_config
        "${COMPOSE[@]}" ps mail-forwarder
        ;;
    logs)
        require_config
        "${COMPOSE[@]}" logs --tail=100 -f mail-forwarder
        ;;
    queue)
        require_config
        "${COMPOSE[@]}" exec -T mail-forwarder postqueue -p
        ;;
    retry)
        require_config
        "${COMPOSE[@]}" exec -T mail-forwarder postqueue -f
        ;;
    *)
        echo 'Usage: ./scripts/mail {build|check|up|reload|stop|status|logs|queue|retry|install-renew-hook}'
        exit 1
        ;;
esac
